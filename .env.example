# Copie para .env e preencha. O .env não vai para o git.
CAMERA_URL=rtsp://admin:SUASENHA@192.168.0.45:554/onvif1
TELEGRAM_TOKEN=SEU_TOKEN
TELEGRAM_CHAT_ID=SEU_CHAT_ID

# Ajustes finos (opcionais)
# Tempo seguido na vasilha, em segundos, para considerar "bebendo"
SEGUNDOS_BEBENDO=3
# Quanto da área da vasilha o gato precisa cobrir (0 a 1)
COBERTURA_MIN=0.15
# Segundos de espera entre um aviso e outro
COOLDOWN=120
# Confiança mínima do YOLO para aceitar "gato" (0 a 1)
CONFIANCA=0.5
